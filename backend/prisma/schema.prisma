generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mascota {
  id                        String   @id @default(uuid())
  nombre                    String
  especie                   String   @default("Perro")
  raza                      String
  genero                    String
  color                     String   @default("Sin especificar")
  tamano                    String   @default("Mediano")
  edad                      String   @default("Adulto")
  senasParticulares         String   @default("")
  senas                     String[] @default([])
  otrasSenas                String   @default("")
  esUrgente                 Boolean  @default(false)
  esAsustadiza              Boolean  @default(false)
  fotoUrl                   String
  ultimaVezFecha            DateTime
  ultimaVezLugarTexto       String
  lat                       Float
  lng                       Float
  nombreContacto            String   @default("")
  emailContacto             String   @default("")
  telefono1                 String
  telefono2                 String   @default("")
  estado                    String   @default("perdida")
  tipoReporte               String   @default("perdida")
  validacion                String   @default("pendiente")
  editToken                 String   @unique
  autorizaTratamientoDatos  Boolean
  clicks                    Int      @default(0)
  createdAt                 DateTime @default(now())
  comunidadId               String?
  comunidad                 Comunidad? @relation(fields: [comunidadId], references: [id], onDelete: SetNull)
}

// Punto de agrupación en el mapa — varias mascotas reportadas en el mismo
// vecindario/zona se pueden vincular acá para verlas juntas. Cualquiera
// (admin o público) puede vincular mascotas ya registradas; solo el admin
// crea/borra el punto de comunidad en sí.
model Comunidad {
  id          String    @id @default(uuid())
  nombre      String
  descripcion String    @default("")
  lat         Float
  lng         Float
  createdAt   DateTime  @default(now())
  mascotas    Mascota[]
}
