generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mascota {
  id                        String   @id @default(uuid())
  nombre                    String
  especie                   String   @default("Perro")
  raza                      String
  genero                    String
  color                     String   @default("Sin especificar")
  tamano                    String   @default("Mediano")
  edad                      String   @default("Adulto")
  senasParticulares         String   @default("")
  senas                     String[] @default([])
  otrasSenas                String   @default("")
  esUrgente                 Boolean  @default(false)
  esAsustadiza              Boolean  @default(false)
  fotoUrl                   String
  ultimaVezFecha            DateTime
  ultimaVezLugarTexto       String
  lat                       Float
  lng                       Float
  lugarResidencia           String
  telefono1                 String
  telefono2                 String
  estado                    String   @default("perdida")
  tipoReporte               String   @default("perdida")
  validacion                String   @default("pendiente")
  editToken                 String   @unique
  autorizaTratamientoDatos  Boolean
  clicks                    Int      @default(0)
  createdAt                 DateTime @default(now())
}
